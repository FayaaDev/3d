{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "openSCADE",
  "permission": {
    "question": "allow",
    "skill": {
      "openscad": "allow",
      "inkscape": "allow"
    }
  },
  "watcher": {
    "ignore": [
      ".opencode/node_modules/**",
      ".agents/skills/inkscape/**/__pycache__/**",
      "**/__pycache__/**",
      "**/.DS_Store",
      "exports/**"
    ]
  }
}
